<view class="mini-app view-{{vm.view}} theme-{{vm.variant}} accent-{{vm.preferences.accent}} {{vm.preferences.reducedTransparency ? 'opaque' : ''}} {{vm.dark ? 'dark' : ''}}" wx:if="{{vm}}">
  <view class="topbar" style="padding-top:{{vm.native ? vm.topInset + 6 : 6}}px;padding-right:{{vm.native ? 104 : 12}}px"><view class="brand" wx:if="{{vm.view !== 'list' && vm.view !== 'messages'}}"><image class="logo" src="{{vm.dark ? '/assets/go-cinch-white.svg' : '/assets/go-cinch.svg'}}" /><text class="brand-title">Go Cinch Admin</text></view><button wx:else class="raw-button icon-button" data-a="back" bindtap="onAction" aria-label="{{vm.l.back}}"><c-icon name="back" /></button><text wx:if="{{vm.view === 'list' || vm.view === 'messages'}}" class="top-title">{{vm.view === 'messages' && !vm.isSent ? vm.l.messageCenter : vm.l.manage}}</text></view>
  <scroll-view class="main-scroll" scroll-into-view="{{vm.scrollTarget}}" bindscrolltolower="onScrollEnd" lower-threshold="120" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page" data-testid="page-{{vm.view}}">
      <view class="page-heading"><text wx:if="{{vm.view === 'home'}}" class="date">{{vm.today}}</text><text class="page-title">{{vm.title}}</text><text class="lead">{{vm.subtitle}}</text></view>
      <view wx:if="{{vm.error}}" class="error-banner" data-testid="page-error" role="alert"><c-icon name="info" /><text class="error-copy">{{vm.error}}</text><button class="raw-button text-action" wx:if="{{vm.canRetryError}}" disabled="{{vm.retryBusy}}" data-a="{{vm.errorRetryAction}}" bindtap="onAction">{{vm.l.retry}}</button></view>
      <view wx:if="{{vm.view === 'auth'}}" class="auth-form">
        <view wx:if="{{vm.resetRequired}}" class="notice">{{vm.l.requiredReset}}</view>
        <view wx:for="{{vm.authFields}}" wx:key="key" data-testid="field-{{item.key}}" class="field {{item.error ? 'invalid' : ''}}">
          <view class="field-label-row"><text class="field-label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text></text><text wx:if="{{item.key === 'auth.username' && vm.usernameBusy}}" class="field-progress">{{vm.l.loading}}</text></view>
          <c-input label="{{item.label}}" name="{{item.key}}" value="{{item.value}}" password="{{item.kind === 'password'}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" bind:focus="onFieldFocus" bind:blur="onFieldBlur" />
          <view wx:if="{{item.key === 'auth.username' && vm.accountFocused && vm.accountHistory.length}}" class="account-history">
            <view class="account-heading"><text>{{vm.l.history}}</text><button class="raw-button account-clear" data-a="accounts-clear" bindtap="onAction">{{vm.l.clearAccounts}}</button></view>
            <view wx:for="{{vm.accountOptions}}" wx:for-item="account" wx:key="value" class="account-row"><button class="raw-button account-pick" data-a="account-pick" data-v="{{account.value}}" bindtap="onAction">{{account.value}}</button><button class="raw-button icon-button" data-a="account-remove" data-v="{{account.value}}" bindtap="onAction" aria-label="{{vm.l.remove}} {{account.value}}"><c-icon name="close" /></button></view>
            <text wx:if="{{!vm.accountOptions.length}}" class="account-empty">{{vm.l.noMatchingAccounts}}</text>
          </view><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text>
        </view>
        <view wx:if="{{!vm.resetRequired && !vm.captcha}}" class="verification"><text class="field-label">{{vm.l.verification}}</text><view class="slider-track" id="slider-track"><text>{{vm.sliderBusy ? vm.l.loading : vm.proof ? vm.l.passed : vm.l.slider}}</text><view class="slider-handle" style="transform:translateX({{vm.sliderPosition}}px)" bindtouchstart="onSliderStart" catchtouchmove="onSliderMove" bindtouchend="onSliderEnd" bindtouchcancel="onSliderCancel"><c-icon name="{{vm.proof ? 'check' : 'chevron'}}" /></view></view></view>
        <view wx:if="{{vm.captcha}}" class="verification"><view class="section-head"><text>{{vm.captcha.hint_text}}</text><c-button class="ui-button" bind:press="onAction" action="refresh-captcha" kind="text" disabled="{{vm.sliderBusy}}">{{vm.l.refresh}}</c-button></view><view class="captcha" id="point-captcha" bindtap="onPoint"><image src="{{vm.captcha.captcha_image}}" mode="widthFix" /><text wx:for="{{vm.captcha.points}}" wx:key="label" class="captcha-point" style="left:{{item.left}}%;top:{{item.top}}%">{{item.label}}</text></view><text wx:if="{{vm.captchaVerified}}" class="success">{{vm.l.passed}}</text></view>
        <text wx:if="{{vm.sliderError || vm.verificationError}}" class="field-error">{{vm.sliderError || vm.verificationError}}</text><view class="auth-submit"><c-button class="ui-button" bind:press="onAction" kind="primary" action="login" loading="{{vm.busy}}">{{vm.resetRequired ? vm.l.continue : vm.register ? vm.l.register : vm.l.login}}</c-button></view><c-button class="ui-button" bind:press="onAction" kind="text" action="navigate" arg="{{vm.register || vm.resetRequired ? '/auth/login' : '/auth/register'}}">{{vm.register || vm.resetRequired ? vm.l.backToLoginLink : vm.l.createAccountLink}}</c-button>
      </view>
      <block wx:if="{{vm.view === 'home'}}">
        <view wx:if="{{vm.workspace}}" class="workspace-card"><c-icon name="shield" /><text class="workspace-title">Go Cinch</text><text class="lead">{{(vm.user ? vm.user.username : '')}}</text><button class="raw-button text-action" data-a="navigate" data-v="{{vm.canUsers ? '/system/user' : '/profile'}}" bindtap="onAction">{{vm.canUsers ? vm.l.users : vm.l.profile}}</button></view>
        <view wx:if="{{vm.canUsers && !vm.workspace}}" class="overview-panel" data-testid="overview-stats" aria-busy="{{vm.booting || vm.summaryLoading}}">
          <view wx:if="{{vm.variant !== 'ant'}}" class="overview-heading"><text>{{vm.variant === 'wot' ? vm.l.accountOverview : vm.l.userOverview}}</text><view class="total-line"><text wx:if="{{vm.summaryLoading || vm.booting}}" class="skeleton skeleton-total"></text><text wx:else class="total-number">{{vm.totalDisplay}}</text><text class="total-unit">{{vm.l.usersUnit}}</text></view><view wx:if="{{vm.variant === 'tdesign'}}" class="hero-shield"><c-icon name="shield" tone="inverse" /></view></view>
          <view class="metrics"><button wx:for="{{vm.stats}}" wx:key="status" class="raw-button metric" data-a="home-status" data-v="{{item.status}}" bindtap="onAction" disabled="{{item.loading || vm.booting}}"><view wx:if="{{item.loading || vm.booting}}" class="skeleton skeleton-number"></view><text wx:else class="metric-value">{{item.display}}</text><text class="metric-label">{{item.label}}</text></button></view>
          <view wx:if="{{vm.variant === 'wot' && vm.total && !vm.summaryLoading}}" class="status-distribution"><view wx:for="{{vm.stats}}" wx:key="status" class="status-segment status-{{item.status}}" style="flex:{{item.value || 0}}"></view></view>
          <view wx:if="{{vm.summaryError}}" class="region-error" role="alert"><text class="error-copy">{{vm.summaryError}}</text><button class="raw-button text-action" data-a="refresh" bindtap="onAction">{{vm.l.retry}}</button></view>
        </view>
        <view wx:if="{{vm.canUsers && !vm.workspace}}" class="section-head"><view class="section-title-line"><text class="section-title">{{vm.l.review}}</text><text class="counter {{vm.reviewsLoading ? 'skeleton' : ''}}">{{vm.reviewsLoading ? ' ' : vm.pendingCount}}</text></view><button class="raw-button section-link" data-a="home-status" data-v="0" bindtap="onAction"><text>{{vm.l.all}}</text><c-icon name="chevron" /></button></view>
        <view wx:if="{{vm.canUsers && !vm.workspace}}" class="card review-card" data-testid="overview-reviews" aria-busy="{{vm.reviewsLoading || vm.booting}}">
          <view wx:if="{{vm.reviewsLoading || vm.booting}}" data-testid="skeleton-reviews"><view wx:for="{{vm.reviewSkeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view>
          <view wx:elif="{{vm.reviewsError}}" class="region-error" role="alert"><c-icon name="info" /><text class="error-copy">{{vm.reviewsError}}</text><button class="raw-button text-action" data-a="refresh" bindtap="onAction">{{vm.l.retry}}</button></view>
          <block wx:else><button wx:for="{{vm.reviews}}" wx:key="id" class="raw-button record" data-a="home-record" data-v="{{item.name}}" bindtap="onAction"><text class="avatar secondary">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><text class="record-note">{{item.role}}</text></view><text class="review-label">{{vm.l.reviewAction}}</text></button><view wx:if="{{!vm.reviews.length}}" class="caught-up"><c-icon name="check" /><text>{{vm.l.reviewEmpty}}</text></view></block>
        </view>
        <view class="section-head"><text class="section-title">{{vm.l.common}}</text><button class="raw-button section-link" data-a="navigate" data-v="/dashboard/overview?tab=manage" bindtap="onAction"><text>{{vm.l.allApps}}</text><c-icon name="chevron" /></button></view>
        <view class="quick-grid" data-testid="quick-apps"><button wx:for="{{vm.quick}}" wx:key="resource" class="raw-button quick-item" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><view class="quick-icon"><c-icon name="{{item.icon}}" tone="accent" /></view><view class="quick-copy"><text class="quick-title">{{item.label}}</text><text class="quick-note">{{vm.l.viewDetails}}</text></view></button></view>
        <button class="raw-button security-hint" data-a="navigate" data-v="/dashboard/overview?tab=security" bindtap="onAction"><c-icon name="shield" /><text class="security-hint-copy">{{vm.l.securityHint}}</text><c-icon name="chevron" /></button>
        <view wx:if="{{vm.canUsers}}" class="section-head"><text class="section-title">{{vm.l.latest}}</text><button class="raw-button section-link" data-a="navigate" data-v="/system/user" bindtap="onAction"><text>{{vm.l.all}}</text><c-icon name="chevron" /></button></view>
        <view wx:if="{{vm.canUsers}}" class="card" data-testid="overview-recent" aria-busy="{{vm.recentLoading || vm.booting}}"><view wx:if="{{vm.recentLoading || vm.booting}}" data-testid="skeleton-recent"><view wx:for="{{vm.skeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view><view wx:elif="{{vm.recentError}}" class="region-error" role="alert"><text class="error-copy">{{vm.recentError}}</text><button class="raw-button text-action" data-a="refresh" bindtap="onAction">{{vm.l.retry}}</button></view><block wx:else><button wx:for="{{vm.recent}}" wx:key="id" class="raw-button record" data-a="home-record" data-v="{{item.name}}" bindtap="onAction"><text class="avatar secondary">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><text class="record-note">{{item.date}}</text></view><c-icon name="chevron" /></button><text wx:if="{{!vm.recent.length}}" class="empty-inline">{{vm.l.noData}}</text></block></view>
      </block>
      <block wx:if="{{vm.view === 'manage'}}">
        <view class="search-field"><c-icon name="search" /><c-input name="search" value="{{vm.query}}" placeholder="{{vm.l.search}}" bind:change="onInput" /></view><block wx:for="{{vm.groups}}" wx:key="title" wx:for-item="group"><view class="section-head"><text class="section-title">{{group.title}}</text></view><view class="app-grid"><button wx:for="{{group.items}}" wx:key="resource" class="raw-button app-item" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><view class="quick-icon"><c-icon name="{{item.icon}}" /></view><text class="record-name">{{item.label}}</text><text class="record-note">{{vm.l.detail}}</text></button></view></block><view wx:if="{{!vm.groups.length}}" class="empty-inline">{{vm.l.noData}}</view>
      </block>
      <block wx:if="{{vm.view === 'list'}}">
        <view class="search-field"><c-icon name="search" /><c-input name="search" label="{{vm.searchLabel}}" value="{{vm.query}}" placeholder="{{vm.searchLabel}}" bind:change="onInput" bind:focus="onFieldFocus" bind:blur="onSearchBlur" /></view>
        <view wx:if="{{vm.primaryTags.length}}" class="primary-filter-tags"><view wx:for="{{vm.primaryTags}}" wx:key="value" class="primary-filter-tag"><view><text wx:for="{{item.lines}}" wx:for-item="line" wx:key="index" class="filter-rule">{{line}}</text></view><button class="raw-button icon-button" data-a="remove-filter-value" data-v="{{item.value}}" bindtap="onAction" aria-label="{{vm.l.remove}}"><c-icon name="close" /></button></view></view><view wx:if="{{vm.searchFocus && vm.suggestions.length}}" class="card suggestions"><view class="section-head"><text>{{vm.l.suggestions}}</text><c-button class="ui-button" bind:press="onAction" action="clear-history" kind="text">{{vm.l.clearHistory}}</c-button></view><view wx:for="{{vm.suggestions}}" wx:key="value" class="suggestion-row"><button class="raw-button suggestion" data-a="suggestion" data-v="{{item.value}}" bindtap="onAction"><text wx:for="{{item.parts || []}}" wx:for-item="part" wx:key="index" class="{{part.match ? 'match' : ''}}">{{part.value}}</text></button><button wx:if="{{item.history}}" class="raw-button icon-button" data-a="remove-history" data-v="{{item.value}}" bindtap="onAction" aria-label="{{vm.l.remove}}"><c-icon name="close" /></button></view></view>
        <view wx:if="{{vm.resource === 'user'}}" class="chips"><button wx:for="{{vm.statusOptions}}" wx:key="value" class="raw-button chip {{item.active ? 'active' : ''}}" data-a="status" data-v="{{item.value}}" bindtap="onAction">{{item.label}}</button></view><view class="filter-actions"><c-button class="ui-button" bind:press="onAction" kind="text" action="filters">{{vm.l.filter}}</c-button><view><c-button class="ui-button" bind:press="onAction" kind="text" action="reset-search">{{vm.l.reset}}</c-button><c-button class="ui-button" bind:press="onAction" kind="text" action="search">{{vm.l.search}}</c-button></view></view>
        <view id="results-top" class="toolbar {{vm.preferences.sticky ? 'is-sticky' : ''}}"><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canCreate}}" kind="primary" action="create">＋ {{vm.l.create}}</c-button><view wx:else></view><view class="toolbar-tools"><button class="raw-button icon-button" data-a="refresh" bindtap="onAction" aria-label="{{vm.l.refresh}}"><c-icon name="refresh" /></button><button class="raw-button icon-button" data-a="density" bindtap="onAction" aria-label="{{vm.l.density}}"><c-icon name="density" /></button><button class="raw-button icon-button" data-a="columns" bindtap="onAction" aria-label="{{vm.l.fields}}"><c-icon name="columns" /></button><button class="raw-button icon-button" data-a="style" bindtap="onAction" aria-label="{{vm.l.style}}"><c-icon name="grid" /></button></view></view>
        <view class="list-meta"><text>{{vm.totalLabel}}</text><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canDelete}}" kind="text" action="select">{{vm.selection ? vm.l.done : vm.l.select}}</c-button></view><view wx:if="{{vm.selection}}" class="selection-bar"><c-button class="ui-button" bind:press="onAction" kind="text" action="select-all">{{vm.l.allSelect}}</c-button><text>{{vm.selectedLabel}}</text><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.selectedCount}}" kind="danger" action="delete">{{vm.l.remove}}</c-button></view>
        <view wx:if="{{vm.loading || vm.booting}}" class="card" data-testid="skeleton-record-list" aria-busy="true"><view wx:for="{{vm.skeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view><view wx:elif="{{vm.canRead && (vm.rows.length || !vm.error)}}" class="record-list {{vm.listStyle}} {{vm.density}} {{vm.preferences.striped ? 'striped' : ''}} {{vm.preferences.bordered ? 'bordered' : ''}}" data-testid="record-list"><button wx:for="{{vm.rows}}" wx:key="id" class="raw-button record" data-a="detail" data-v="{{item.id}}" bindtap="onAction"><text wx:if="{{vm.selection}}" class="select-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text><text wx:else class="avatar">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><view wx:for="{{item.summary}}" wx:for-item="field" wx:key="key" class="record-summary"><view wx:if="{{field.tokens.length}}" class="token-list"><c-tag wx:for="{{field.tokens}}" wx:for-item="token" wx:key="label" tone="{{token.tone}}">{{token.label}}</c-tag></view><text wx:else class="record-note">{{field.value}}</text><text wx:if="{{field.note}}" class="record-note">{{field.note}}</text></view></view><c-tag wx:if="{{vm.resource === 'user' && item.showStatus}}" tone="{{item.status === 1 ? 'success' : item.status === 2 ? 'danger' : 'warning'}}">{{item.statusLabel}}</c-tag><c-tag wx:if="{{vm.resource === 'dictionary' && item.showEnabled}}" tone="{{item.enabled ? 'success' : 'default'}}">{{item.enabledLabel}}</c-tag><c-icon name="chevron" /></button><view wx:if="{{!vm.rows.length && !vm.error}}" class="empty"><c-icon name="book" /><text>{{vm.l.noData}}</text><text class="hint">{{vm.l.emptyHint}}</text></view></view>
      </block>
      <block wx:if="{{vm.view === 'messages'}}">
        <view class="filter-actions message-actions"><view class="chips message-tabs"><button wx:for="{{vm.messageTypes}}" wx:key="value" class="raw-button message-tab {{item.active ? 'active' : ''}}" data-a="message-type-filter" data-v="{{item.value}}" bindtap="onAction">{{item.label}}</button></view><button wx:if="{{!vm.isSent}}" class="raw-button text-action" data-a="read-all" bindtap="onAction">{{vm.l.allRead}}</button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.isSent && vm.canSend}}" action="compose" kind="primary">{{vm.l.send}}</c-button></view>
        <view wx:if="{{vm.isSent}}" id="results-top" class="toolbar {{vm.preferences.sticky ? 'is-sticky' : ''}}"><view></view><view class="toolbar-tools"><button class="raw-button icon-button" data-a="refresh" bindtap="onAction" aria-label="{{vm.l.refresh}}"><c-icon name="refresh" /></button><button class="raw-button icon-button" data-a="density" bindtap="onAction" aria-label="{{vm.l.density}}"><c-icon name="density" /></button><button class="raw-button icon-button" data-a="columns" bindtap="onAction" aria-label="{{vm.l.fields}}"><c-icon name="columns" /></button><button class="raw-button icon-button" data-a="style" bindtap="onAction" aria-label="{{vm.l.style}}"><c-icon name="grid" /></button></view></view><view wx:if="{{vm.isSent}}" class="list-meta"><text>{{vm.totalLabel}}</text><button wx:if="{{vm.canDeleteMessage}}" class="raw-button text-action" data-a="select" bindtap="onAction">{{vm.selection ? vm.l.done : vm.l.select}}</button></view>
        <view wx:if="{{vm.isSent && vm.selection}}" class="selection-bar"><button class="raw-button text-action" data-a="select-all" bindtap="onAction">{{vm.l.allSelect}}</button><text>{{vm.selectedLabel}}</text><c-button class="ui-button" wx:if="{{vm.selectedCount}}" bind:press="onAction" kind="danger" action="delete">{{vm.l.remove}}</c-button></view>
        <view wx:if="{{vm.loading || vm.booting}}" class="card" data-testid="skeleton-messages" aria-busy="true"><view wx:for="{{vm.skeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view>
        <view wx:else class="message-list {{vm.density}} {{vm.preferences.striped ? 'striped' : ''}} {{vm.preferences.bordered ? 'bordered' : ''}}" data-testid="message-list"><view wx:for="{{vm.messageRows}}" wx:key="id" class="inbox-item {{item.read ? 'is-read' : 'is-unread'}}" data-testid="message-{{item.id}}"><button wx:if="{{!vm.isSent}}" class="raw-button message-delete" data-a="message-delete" data-v="{{item.id}}" bindtap="onAction">{{vm.l.remove}}</button><button disabled="{{item.busy}}" class="raw-button message-row {{vm.swipedMessage === item.id ? 'swiped' : ''}}" data-id="{{item.id}}" data-a="{{vm.isSent ? 'detail' : 'message-read'}}" data-v="{{item.id}}" bindtap="onAction" bindtouchstart="onMessageStart" bindtouchend="onMessageEnd"><view class="message-title"><text wx:if="{{vm.selection}}" class="select-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text><text wx:elif="{{!item.read && !vm.isSent}}" class="unread-dot"></text><text class="message-title-copy">{{item.title}}</text><c-tag wx:if="{{!vm.isSent || item.showType}}">{{item.type}}</c-tag></view><text class="message-preview {{vm.isSent ? '' : 'message-full'}}">{{item.content}}</text><view class="message-meta"><text wx:if="{{!vm.isSent || item.showDate}}">{{item.date}}</text><text wx:if="{{vm.isSent && item.showScope}}">{{item.scope}}</text><c-icon wx:if="{{vm.isSent}}" name="chevron" /><text wx:elif="{{item.read}}" class="read-mark">{{vm.l.read}}</text></view></button></view><view wx:if="{{!vm.error && !vm.messageRows.length}}" class="empty"><c-icon name="inbox" /><text>{{vm.l.noData}}</text></view></view>
        <view wx:if="{{!vm.isSent && vm.hasMore}}" class="load-more"><c-button class="ui-button" bind:press="onAction" action="message-more" kind="text" loading="{{vm.loadingMore}}">{{vm.l.loadMore}}</c-button></view>
      </block>
      <view wx:if="{{vm.view === 'list' || vm.isSent}}" class="pagination"><c-button class="ui-button" bind:press="onAction" kind="text" action="prev" disabled="{{vm.page <= 1 || vm.loading}}">{{vm.l.prev}}</c-button><text>{{vm.pageLabel}}</text><c-button class="ui-button" bind:press="onAction" kind="text" action="page-size">{{vm.size}}</c-button><c-button class="ui-button" bind:press="onAction" kind="text" action="next" disabled="{{vm.page >= vm.pages || vm.loading}}">{{vm.l.next}}</c-button></view>
      <block wx:if="{{vm.view === 'profile'}}">
        <view wx:if="{{vm.profileLoading || vm.booting}}" class="profile-card" data-testid="skeleton-profile"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view></view>
        <view wx:else class="profile-card"><text class="avatar large">{{vm.initials}}</text><view class="record-main"><text class="record-name">{{(vm.user ? vm.user.username : '')}}</text><text class="record-note">{{(vm.user && vm.user.role ? vm.user.role.name : vm.l.session)}}</text><text class="record-note">{{(vm.user ? vm.user.code : '')}}</text></view></view>
        <view wx:if="{{vm.profileError}}" class="error-banner" role="alert"><text class="error-copy">{{vm.profileError}}</text><button class="raw-button text-action" data-a="refresh" bindtap="onAction">{{vm.l.retry}}</button></view>
        <view class="section-head"><text class="section-title">{{vm.l.session}}</text></view><view class="card"><button class="raw-button menu-row" data-a="profile" bindtap="onAction"><c-icon name="user" tone="accent" /><text class="menu-label">{{vm.l.profile}}</text><c-icon name="chevron" /></button><button class="raw-button menu-row" data-a="password" bindtap="onAction"><c-icon name="key" tone="accent" /><text class="menu-label">{{vm.l.passwordChange}}</text><c-icon name="chevron" /></button><button class="raw-button menu-row" data-a="lock" bindtap="onAction"><c-icon name="lock" tone="accent" /><text class="menu-label">{{vm.l.lock}}</text><c-icon name="chevron" /></button></view>
