<view class="mini-app theme-{{vm.variant}} accent-{{vm.preferences.accent}} {{vm.preferences.reducedTransparency ? 'opaque' : ''}} {{vm.dark ? 'dark' : ''}}" wx:if="{{vm}}">
  <view class="topbar" style="padding-top:{{vm.native ? vm.topInset + 6 : 6}}px;padding-right:{{vm.native ? 104 : 12}}px"><view class="brand" wx:if="{{vm.view !== 'list' && vm.view !== 'messages'}}"><image class="logo" src="{{vm.dark ? '/assets/go-cinch-white.svg' : '/assets/go-cinch.svg'}}" /><text class="brand-title">{{vm.native ? 'Go Cinch' : 'Go Cinch Admin'}}</text></view><button wx:else class="icon-button" data-a="back" bindtap="onAction" aria-label="{{vm.l.back}}"><c-icon name="back" /></button><text wx:if="{{vm.view === 'list' || vm.view === 'messages'}}" class="top-title">{{vm.l.manage}}</text><button wx:if="{{vm.view !== 'auth'}}" class="icon-button" data-a="navigate" data-v="/msg/inbox" bindtap="onAction" aria-label="{{vm.l.messages}}"><c-icon name="bell" /><text wx:if="{{vm.unread}}" class="badge">{{vm.unread}}</text></button></view>
  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page">
      <view wx:if="{{vm.booting}}" class="boot"><view class="skeleton sk-line"></view><view class="skeleton sk-block"></view><text>{{vm.l.loading}}</text></view>
      <block wx:else>
      <view class="page-heading"><text wx:if="{{vm.view === 'home'}}" class="date">{{vm.today}}</text><text class="page-title">{{vm.title}}</text><text class="lead">{{vm.subtitle}}</text></view>
      <view wx:if="{{vm.error}}" class="error-box"><text>{{vm.error}}</text><c-button class="ui-button" bind:press="onAction" action="refresh" kind="text">{{vm.l.retry}}</c-button></view>
      <view wx:if="{{vm.view === 'auth'}}" class="auth-form">
        <view wx:if="{{vm.resetRequired}}" class="notice">{{vm.l.requiredReset}}</view>
        <view wx:for="{{vm.authFields}}" wx:key="key" class="field {{item.error ? 'invalid' : ''}}">
          <view class="field-label-row"><text class="field-label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text></text><text wx:if="{{item.key === 'auth.username' && vm.usernameBusy}}" class="field-progress">{{vm.l.loading}}</text></view>
          <c-input label="{{item.label}}" name="{{item.key}}" value="{{item.value}}" password="{{item.kind === 'password'}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" bind:focus="onFieldFocus" bind:blur="onFieldBlur" />
          <view wx:if="{{item.key === 'auth.username' && vm.accountFocused && vm.accountHistory.length}}" class="account-history">
            <view class="account-heading"><text>{{vm.l.history}}</text><button class="account-clear" data-a="accounts-clear" bindtap="onAction">{{vm.l.clearAccounts}}</button></view>
            <view wx:for="{{vm.accountOptions}}" wx:for-item="account" wx:key="value" class="account-row"><button class="account-pick" data-a="account-pick" data-v="{{account.value}}" bindtap="onAction">{{account.value}}</button><button class="icon-button" data-a="account-remove" data-v="{{account.value}}" bindtap="onAction" aria-label="{{vm.l.remove}} {{account.value}}"><c-icon name="close" /></button></view>
            <text wx:if="{{!vm.accountOptions.length}}" class="account-empty">{{vm.l.noMatchingAccounts}}</text>
          </view><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text>
        </view>
        <view wx:if="{{!vm.resetRequired && !vm.captcha}}" class="verification"><text class="field-label">{{vm.l.verification}}</text><view class="slider-track" id="slider-track"><text>{{vm.sliderBusy ? vm.l.loading : vm.proof ? vm.l.passed : vm.l.slider}}</text><view class="slider-handle" style="transform:translateX({{vm.sliderPosition}}px)" bindtouchstart="onSliderStart" catchtouchmove="onSliderMove" bindtouchend="onSliderEnd" bindtouchcancel="onSliderCancel"><c-icon name="{{vm.proof ? 'check' : 'chevron'}}" /></view></view></view>
        <view wx:if="{{vm.captcha}}" class="verification"><view class="section-head"><text>{{vm.captcha.hint_text}}</text><c-button class="ui-button" bind:press="onAction" action="refresh-captcha" kind="text" disabled="{{vm.sliderBusy}}">{{vm.l.refresh}}</c-button></view><view class="captcha" id="point-captcha" bindtap="onPoint"><image src="{{vm.captcha.captcha_image}}" mode="widthFix" /><text wx:for="{{vm.captcha.points}}" wx:key="label" class="captcha-point" style="left:{{item.left}}%;top:{{item.top}}%">{{item.label}}</text></view><text wx:if="{{vm.captchaVerified}}" class="success">{{vm.l.passed}}</text></view>
        <text wx:if="{{vm.sliderError || vm.verificationError}}" class="field-error">{{vm.sliderError || vm.verificationError}}</text><view class="auth-submit"><c-button class="ui-button" bind:press="onAction" kind="primary" action="login" loading="{{vm.busy}}">{{vm.resetRequired ? vm.l.continue : vm.register ? vm.l.register : vm.l.login}}</c-button></view><c-button class="ui-button" bind:press="onAction" kind="text" action="navigate" arg="{{vm.register || vm.resetRequired ? '/auth/login' : '/auth/register'}}">{{vm.register || vm.resetRequired ? vm.l.backToLoginLink : vm.l.createAccountLink}}</c-button>
      </view>
      <block wx:if="{{vm.view === 'home'}}">
        <view wx:if="{{vm.canUsers}}" class="overview-panel"><view wx:if="{{vm.variant !== 'ant'}}" class="overview-heading"><text>{{vm.l.userOverview}}</text><text class="total-number">{{vm.total}}</text></view><view class="metrics"><button wx:for="{{vm.stats}}" wx:key="status" class="metric" data-a="home-status" data-v="{{item.status}}" bindtap="onAction"><text class="metric-value {{item.loading ? 'skeleton' : ''}}">{{item.loading ? ' ' : item.error ? '—' : item.value}}</text><text>{{item.label}}</text><text wx:if="{{item.error}}" class="metric-error">!</text></button></view></view>
        <view wx:if="{{vm.canUsers}}" class="section-head"><text class="section-title">{{vm.l.review}}</text><c-button class="ui-button" bind:press="onAction" kind="text" action="home-status" arg="0">{{vm.l.all}}</c-button></view>
        <view wx:if="{{vm.canUsers}}" class="card"><view wx:if="{{vm.reviewsLoading}}" class="skeleton sk-block"></view><button wx:for="{{vm.reviews}}" wx:key="id" class="record" data-a="home-record" data-v="{{item.name}}" bindtap="onAction"><text class="avatar">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><text class="record-note">{{item.role}}</text></view><text class="review-label">{{vm.l.reviewAction}}</text></button><text wx:if="{{!vm.reviewsLoading && !vm.reviews.length}}" class="empty-inline">{{vm.l.noData}}</text></view>
        <view class="section-head"><text class="section-title">{{vm.l.common}}</text><c-button class="ui-button" bind:press="onAction" action="navigate" arg="/dashboard/overview?tab=manage" kind="text">{{vm.l.all}}</c-button></view><view class="quick-grid"><button wx:for="{{vm.quick}}" wx:key="resource" class="quick-item" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><view class="quick-icon"><c-icon name="{{item.icon}}" /></view><text>{{item.label}}</text></button></view>
        <button class="security-hint" data-a="navigate" data-v="/dashboard/overview?tab=security" bindtap="onAction"><c-icon name="shield" /><text>{{vm.l.security}}</text><c-icon name="chevron" /></button>
        <view wx:if="{{vm.canUsers}}" class="section-head"><text class="section-title">{{vm.l.latest}}</text><c-button class="ui-button" bind:press="onAction" action="navigate" arg="/system/user" kind="text">{{vm.l.all}}</c-button></view><view wx:if="{{vm.canUsers}}" class="card"><view wx:if="{{vm.recentLoading}}" class="skeleton sk-block"></view><text wx:if="{{vm.recentError}}" class="field-error">{{vm.recentError}}</text><button wx:for="{{vm.recent}}" wx:key="id" class="record" data-a="home-record" data-v="{{item.name}}" bindtap="onAction"><text class="avatar">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><text class="record-note">{{item.date}}</text></view><c-icon name="chevron" /></button></view>
      </block>
      <block wx:if="{{vm.view === 'manage'}}">
        <view class="search-field"><c-icon name="search" /><c-input name="search" value="{{vm.query}}" placeholder="{{vm.l.search}}" bind:change="onInput" /></view><block wx:for="{{vm.groups}}" wx:key="title" wx:for-item="group"><view class="section-head"><text class="section-title">{{group.title}}</text></view><view class="app-grid"><button wx:for="{{group.items}}" wx:key="resource" class="app-item" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><view class="quick-icon"><c-icon name="{{item.icon}}" /></view><text class="record-name">{{item.label}}</text><text class="record-note">{{vm.l.detail}}</text></button></view></block><view wx:if="{{!vm.groups.length}}" class="empty-inline">{{vm.l.noData}}</view>
      </block>
      <block wx:if="{{vm.view === 'list'}}">
        <view class="search-field"><c-icon name="search" /><c-input name="search" value="{{vm.query}}" placeholder="{{vm.l.search}}" bind:change="onInput" bind:blur="onSearchBlur" /></view>
        <view wx:if="{{vm.searchFocus && vm.suggestions.length}}" class="card suggestions"><view class="section-head"><text>{{vm.l.suggestions}}</text><c-button class="ui-button" bind:press="onAction" action="clear-history" kind="text">{{vm.l.clearHistory}}</c-button></view><button wx:for="{{vm.suggestions}}" wx:key="value" class="suggestion" data-a="suggestion" data-v="{{item.value}}" bindtap="onAction"><text wx:for="{{item.parts}}" wx:for-item="part" wx:key="index" class="{{part.match ? 'match' : ''}}">{{part.value}}</text></button></view>
        <view wx:if="{{vm.resource === 'user'}}" class="chips"><button wx:for="{{vm.statusOptions}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-a="status" data-v="{{item.value}}" bindtap="onAction">{{item.label}}</button></view><view class="filter-actions"><c-button class="ui-button" bind:press="onAction" kind="text" action="filters">{{vm.l.filter}}</c-button><view><c-button class="ui-button" bind:press="onAction" kind="text" action="reset-search">{{vm.l.reset}}</c-button><c-button class="ui-button" bind:press="onAction" kind="text" action="search">{{vm.l.search}}</c-button></view></view>
        <view class="toolbar"><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canCreate}}" kind="primary" action="create">＋ {{vm.l.create}}</c-button><view wx:else></view><view class="toolbar-tools"><button class="icon-button" data-a="refresh" bindtap="onAction" aria-label="{{vm.l.refresh}}"><c-icon name="refresh" /></button><button class="icon-button" data-a="density" bindtap="onAction" aria-label="{{vm.l.density}}"><c-icon name="density" /></button><button class="icon-button" data-a="columns" bindtap="onAction" aria-label="{{vm.l.fields}}"><c-icon name="columns" /></button><button class="icon-button" data-a="style" bindtap="onAction" aria-label="{{vm.l.style}}"><c-icon name="grid" /></button></view></view>
        <view class="list-meta"><text>{{vm.totalLabel}}</text><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canDelete}}" kind="text" action="select">{{vm.selection ? vm.l.done : vm.l.select}}</c-button></view><view wx:if="{{vm.selection}}" class="selection-bar"><c-button class="ui-button" bind:press="onAction" kind="text" action="select-all">{{vm.l.allSelect}}</c-button><text>{{vm.selectedLabel}}</text><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.selectedCount}}" kind="danger" action="delete">{{vm.l.remove}}</c-button></view>
        <view wx:if="{{vm.loading}}" class="card"><view class="skeleton sk-block"></view><view class="skeleton sk-block"></view><view class="skeleton sk-block"></view></view><view wx:elif="{{!vm.error && vm.canRead}}" class="record-list {{vm.listStyle}} {{vm.density}}"><button wx:for="{{vm.rows}}" wx:key="id" class="record" data-a="detail" data-v="{{item.id}}" bindtap="onAction"><text wx:if="{{vm.selection}}" class="select-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text><text wx:else class="avatar">{{item.initials}}</text><view class="record-main"><text class="record-name">{{item.name}}</text><text wx:for="{{item.summary}}" wx:for-item="field" wx:key="key" class="record-note">{{field.value}}</text></view><c-tag wx:if="{{vm.resource === 'user'}}" tone="{{item.status === 1 ? 'success' : item.status === 2 ? 'danger' : 'warning'}}">{{item.statusLabel}}</c-tag><c-tag wx:if="{{vm.resource === 'dictionary'}}" tone="{{item.enabled ? 'success' : 'default'}}">{{item.enabledLabel}}</c-tag><c-icon name="chevron" /></button><view wx:if="{{!vm.rows.length}}" class="empty"><c-icon name="book" /><text>{{vm.l.noData}}</text><text class="hint">{{vm.l.emptyHint}}</text></view></view>
      </block>
      <block wx:if="{{vm.view === 'messages'}}"><view class="filter-actions"><view class="chips"><button class="chip {{vm.messageRead === 'all' ? 'active' : ''}}" data-a="message-filter" data-v="all" bindtap="onAction">{{vm.l.all}}</button><button wx:if="{{!vm.isSent}}" class="chip {{vm.messageRead === 'unread' ? 'active' : ''}}" data-a="message-filter" data-v="unread" bindtap="onAction">{{vm.l.unread}}</button></view><c-button class="ui-button" bind:press="onAction" wx:if="{{!vm.isSent}}" action="read-all" kind="text">{{vm.l.allRead}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.isSent && vm.canSend}}" action="compose" kind="primary">{{vm.l.send}}</c-button></view><view wx:if="{{vm.loading}}" class="skeleton sk-block"></view><view wx:else class="card"><button wx:for="{{vm.messageRows}}" wx:key="id" class="message-row" data-a="detail" data-v="{{item.id}}" bindtap="onAction"><view class="message-title"><text wx:if="{{!item.read}}" class="unread-dot"></text><text>{{item.title}}</text></view><text class="message-preview">{{item.content}}</text><view class="message-meta"><text>{{item.date}}</text><c-tag>{{item.type}}</c-tag></view></button><view wx:if="{{!vm.error && !vm.messageRows.length}}" class="empty">{{vm.l.noData}}</view></view></block>
      <view wx:if="{{vm.view === 'list' || vm.view === 'messages'}}" class="pagination"><c-button class="ui-button" bind:press="onAction" kind="text" action="prev" disabled="{{vm.page <= 1 || vm.loading}}">{{vm.l.prev}}</c-button><text>{{vm.pageLabel}}</text><c-button class="ui-button" bind:press="onAction" kind="text" action="page-size">{{vm.size}}</c-button><c-button class="ui-button" bind:press="onAction" kind="text" action="next" disabled="{{vm.page >= vm.pages || vm.loading}}">{{vm.l.next}}</c-button></view>
      <block wx:if="{{vm.view === 'profile' || vm.view === 'security'}}"><view class="profile-card"><text class="avatar large">{{vm.initials}}</text><view><text class="record-name">{{vm.user.username}}</text><text class="record-note">{{vm.user.role.name || vm.l.session}}</text><text class="record-note">{{vm.user.code}}</text></view></view><view class="section-head"><text class="section-title">{{vm.l.session}}</text></view><view class="card"><button class="menu-row" data-a="profile" bindtap="onAction"><c-icon name="user" /><text>{{vm.l.profile}}</text><c-icon name="chevron" /></button><button class="menu-row" data-a="password" bindtap="onAction"><c-icon name="key" /><text>{{vm.l.passwordChange}}</text><c-icon name="chevron" /></button><button wx:if="{{vm.view === 'security'}}" class="menu-row" data-a="lock" bindtap="onAction"><c-icon name="shield" /><text>{{vm.l.lock}}</text><c-icon name="chevron" /></button></view><view wx:if="{{vm.view === 'profile'}}" class="section-head"><text class="section-title">{{vm.l.settings}}</text></view><view wx:if="{{vm.view === 'profile'}}" class="card"><button class="menu-row" data-a="settings" bindtap="onAction"><c-icon name="settings" /><text class="menu-label">{{vm.l.interfaceSettings}}</text><c-icon name="chevron" /></button></view><view class="logout"><c-button class="ui-button" bind:press="onAction" action="logout" kind="danger">{{vm.l.logout}}</c-button></view></block>
      </block>
      <view wx:if="{{vm.footer || vm.view === 'auth'}}" class="copyright"><view class="copyright-line"><text wx:if="{{vm.footer}}" class="copyright-copy">{{vm.copyright}}</text><button wx:if="{{vm.view === 'auth'}}" class="icon-button footer-settings" data-a="settings" bindtap="onAction" aria-label="{{vm.l.interfaceSettings}}"><c-icon name="settings" /></button></view><text wx:if="{{vm.footer && vm.icp}}">{{vm.icp}}</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{vm.view !== 'auth'}}" class="dock"><button wx:for="{{vm.dock}}" wx:key="key" class="dock-item {{item.active ? 'active' : ''}}" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><c-icon name="{{item.icon}}" /><text>{{item.label}}</text></button></view>
  <view wx:if="{{vm.settingsOpen}}" class="settings-screen">
    <view class="settings-topbar" style="padding-top:{{vm.native ? vm.topInset + 6 : 6}}px;padding-right:{{vm.native ? 104 : 16}}px"><button class="icon-button" data-a="close" bindtap="onAction" aria-label="{{vm.l.back}}"><c-icon name="back" /></button><text class="settings-title">{{vm.l.interfaceSettings}}</text></view>
    <scroll-view class="settings-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="settings-body">
      <text class="settings-description">{{vm.l.settingsDescription}}</text>
      <text class="settings-section-label">{{vm.l.appearance}}</text>
      <view class="settings-group">
        <view class="settings-row"><view class="settings-icon"><view class="settings-moon"></view></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.dark}}</text></view><c-switch class="ui-switch" name="preference.dark" checked="{{vm.preferences.dark}}" bind:change="onInput" /></view>
        <view class="settings-row"><view class="settings-icon"><c-icon name="layers" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.reduced}}</text><text class="settings-row-note">{{vm.l.reducedHint}}</text></view><c-switch class="ui-switch" name="preference.reducedTransparency" checked="{{vm.preferences.reducedTransparency}}" bind:change="onInput" /></view>
        <view class="settings-color-section"><text class="settings-row-title">{{vm.l.color}}</text><view class="palette-options"><button wx:for="{{vm.palette}}" wx:key="value" class="palette-option {{item.selected ? 'selected' : ''}}" data-a="accent" data-v="{{item.value}}" bindtap="onAction" aria-pressed="{{item.selected}}"><view class="palette-color" style="background-color:{{item.color}}"><text wx:if="{{item.selected}}">✓</text></view><text>{{item.label}}</text></button></view></view>
      </view>
      <text class="settings-section-label">{{vm.l.general}}</text>
      <view class="settings-group">
        <button class="settings-row" data-a="language" bindtap="onAction"><view class="settings-icon"><c-icon name="globe" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.language}}</text></view><text class="settings-value">{{vm.language}}</text><c-icon name="chevron" /></button>
        <button class="settings-row" data-a="timezone" bindtap="onAction"><view class="settings-icon"><c-icon name="clock" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.timezone}}</text></view><text class="settings-value">{{vm.preferences.timezone}}</text><c-icon name="chevron" /></button>
      </view>
      <text class="settings-section-label">{{vm.l.layout}}</text>
      <view class="settings-group">
        <view class="settings-row"><view class="settings-icon"><c-icon name="layout" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.footer}}</text></view><c-switch class="ui-switch" name="preference.footer" checked="{{vm.preferences.footer}}" bind:change="onInput" /></view>
        <button class="settings-row" data-a="preferences" bindtap="onAction"><view class="settings-icon"><c-icon name="book" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.copyrightInfo}}</text></view><text class="settings-value">{{vm.preferences.company}}</text><c-icon name="chevron" /></button>
      </view><text class="settings-footnote">{{vm.l.settingsSaved}}</text>
    </view></scroll-view>
  </view>
  <view wx:if="{{vm.sheet && vm.sheet.type !== 'settings'}}" class="overlay"><view class="mask" data-a="close" bindtap="onAction"></view><view class="sheet"><view class="handle"></view><view class="sheet-header"><text>{{vm.sheet.title}}</text><button class="icon-button" data-a="close" bindtap="onAction" aria-label="{{vm.l.close}}"><c-icon name="close" /></button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body">
    <text wx:if="{{vm.sheetError}}" class="field-error">{{vm.sheetError}}</text><view wx:if="{{vm.sheet.loading}}" class="skeleton sk-block"></view>
    <block wx:if="{{vm.sheet.type === 'detail' || vm.sheet.type === 'profile'}}"><text class="detail-name">{{vm.recordName}}</text><view wx:for="{{vm.details}}" wx:key="key" class="detail-field"><text class="detail-label">{{item.label}}</text><scroll-view wx:if="{{item.json}}" class="json-box" scroll-y><text selectable>{{item.value}}</text></scroll-view><view wx:else class="detail-value"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</text></view></view></block>
    <view wx:for="{{vm.fields}}" wx:key="key" class="field {{item.error ? 'invalid' : ''}}"><text class="field-label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text></text><c-switch class="ui-switch" wx:if="{{item.kind === 'switch'}}" name="{{item.key}}" checked="{{item.value}}" bind:change="onInput" /><c-button class="ui-button" bind:press="onAction" wx:elif="{{item.kind === 'picker'}}" kind="outline" action="picker" arg="{{item.key}}">{{item.display}}</c-button><c-textarea wx:elif="{{item.kind === 'textarea'}}" name="{{item.key}}" value="{{item.value}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" /><c-input wx:else name="{{item.key}}" value="{{item.value}}" password="{{item.kind === 'password'}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" /><text wx:if="{{item.key === 'form.year'}}" class="hint">{{vm.l.autoYearHint}}</text><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text></view>
    <block wx:if="{{vm.sheet.type === 'password' && vm.captcha}}"><view class="section-head"><text>{{vm.captcha.hint_text}}</text><c-button class="ui-button" bind:press="onAction" action="refresh-captcha" kind="text">{{vm.l.refresh}}</c-button></view><view class="captcha" id="point-captcha" bindtap="onPoint"><image src="{{vm.captcha.captcha_image}}" mode="widthFix" /><text wx:for="{{vm.captcha.points}}" wx:key="label" class="captcha-point" style="left:{{item.left}}%;top:{{item.top}}%">{{item.label}}</text></view><text wx:if="{{vm.verificationError || vm.sliderError}}" class="field-error">{{vm.verificationError || vm.sliderError}}</text></block>
    <view wx:if="{{vm.sheet.type === 'picker'}}" class="search-field"><c-icon name="search" /><c-input name="picker" value="{{vm.optionsQuery}}" placeholder="{{vm.l.search}}" bind:change="onInput" /></view><view wx:if="{{vm.optionsLoading}}" class="skeleton sk-block"></view><button wx:for="{{vm.choices}}" wx:key="value" class="option {{item.selected ? 'active' : ''}}" data-a="{{item.action}}" data-v="{{item.value}}" bindtap="onAction"><text>{{item.label}}</text><text>{{item.selected ? '✓' : ''}}</text></button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' && vm.optionsMore}}" action="options-more" kind="text">{{vm.l.loadMore}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' && vm.sheetError}}" action="options-retry" kind="text">{{vm.l.retry}}</c-button>
    <block wx:if="{{vm.sheet.type === 'preferences'}}"><text class="settings-hint">{{vm.l.copyrightHiddenHint}}</text><view class="remember-row"><text>{{vm.l.copyrightVisible}}</text><c-switch class="ui-switch" name="form.copyright" checked="{{vm.form.copyright}}" bind:change="onInput" /></view></block>
    <block wx:if="{{vm.sheet.type === 'operation' && vm.sheet.operation === 'review'}}"><view class="chips"><button class="chip {{vm.form.decision === 'approve' ? 'active' : ''}}" data-a="decision" data-v="approve" bindtap="onAction">{{vm.extra.approve}}</button><button class="chip {{vm.form.decision === 'reject' ? 'active' : ''}}" data-a="decision" data-v="reject" bindtap="onAction">{{vm.extra.reject}}</button></view></block><block wx:if="{{vm.sheet.type === 'operation' && vm.sheet.operation === 'lock'}}"><view class="chips"><button class="chip {{vm.form.lockMode === 'until' ? 'active' : ''}}" data-a="lock-mode" data-v="until" bindtap="onAction">{{vm.extra.until}}</button><button class="chip {{vm.form.lockMode === 'permanent' ? 'active' : ''}}" data-a="lock-mode" data-v="permanent" bindtap="onAction">{{vm.extra.permanent}}</button></view></block>
    <block wx:if="{{vm.sheet.type === 'compose'}}"><text class="field-label">{{vm.extra.messageType}}</text><view class="chips"><button class="chip {{vm.form.type === 'notice' ? 'active' : ''}}" data-a="message-type" data-v="notice" bindtap="onAction">{{vm.extra.notice}}</button><button class="chip {{vm.form.type === 'system' ? 'active' : ''}}" data-a="message-type" data-v="system" bindtap="onAction">{{vm.extra.system}}</button></view><text class="field-label">{{vm.extra.scope}}</text><view class="chips"><button class="chip {{vm.form.scope === 'all' ? 'active' : ''}}" data-a="message-scope" data-v="all" bindtap="onAction">{{vm.l.all}}</button><button class="chip {{vm.form.scope === 'targeted' ? 'active' : ''}}" data-a="message-scope" data-v="targeted" bindtap="onAction">{{vm.extra.targeted}}</button></view></block>
    <view wx:if="{{vm.sheet.type === 'message'}}" class="message-detail"><text class="detail-name">{{vm.message.title}}</text><text class="record-note">{{vm.message.date}} · {{vm.message.type}}</text><text class="message-content" selectable>{{vm.message.content}}</text></view>
    <text wx:if="{{vm.sheet.type === 'discard'}}" class="lead">{{vm.extra.discardHint}}</text>
  </view></scroll-view><view class="sheet-footer">
    <block wx:if="{{vm.sheet.type === 'detail' && !vm.sheet.loading && !vm.sheetError}}"><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canDelete}}" kind="danger" action="delete">{{vm.l.remove}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canUpdate}}" kind="primary" action="edit">{{vm.l.edit}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate && vm.recordStatus === 0}}" action="review">{{vm.l.reviewAction}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate}}" action="{{vm.recordStatus === 2 ? 'unlock-user' : 'lock-user'}}">{{vm.recordStatus === 2 ? vm.extra.unlock : vm.extra.lock}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate && vm.hasPasswordLock}}" action="unlock-password">{{vm.extra.unlockPassword}}</c-button></block>
    <c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'edit'}}" kind="primary" action="save" loading="{{vm.busy}}">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'password'}}" kind="primary" action="save-password" loading="{{vm.busy}}">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'compose'}}" kind="primary" action="send" loading="{{vm.busy}}">{{vm.l.send}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'timezone'}}" kind="primary" action="timezone-save">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'preferences'}}" kind="primary" action="save-preferences">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'filters'}}" kind="primary" action="apply-filters">{{vm.l.confirm}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' || vm.sheet.type === 'columns' || vm.sheet.type === 'language'}}" kind="primary" action="close">{{vm.l.done}}</c-button>
    <block wx:if="{{vm.sheet.type === 'operation'}}"><c-button class="ui-button" bind:press="onAction" action="close">{{vm.l.cancel}}</c-button><c-button class="ui-button" bind:press="onAction" kind="primary" action="operate" loading="{{vm.busy}}">{{vm.l.confirm}}</c-button></block><block wx:if="{{vm.sheet.type === 'discard'}}"><c-button class="ui-button" bind:press="onAction" action="keep-editing">{{vm.extra.keep}}</c-button><c-button class="ui-button" bind:press="onAction" kind="danger" action="discard">{{vm.extra.discard}}</c-button></block><block wx:if="{{vm.sheet.type === 'logout'}}"><c-button class="ui-button" bind:press="onAction" action="close">{{vm.l.cancel}}</c-button><c-button class="ui-button" bind:press="onAction" kind="danger" action="confirm-logout" loading="{{vm.busy}}">{{vm.l.logout}}</c-button></block><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'message' && vm.canDeleteMessage}}" kind="danger" action="delete">{{vm.l.remove}}</c-button>
  </view></view></view>
</view>
