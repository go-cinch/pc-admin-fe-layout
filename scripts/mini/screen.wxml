        <button class="raw-button settings-row" data-a="preferences" bindtap="onAction"><view class="settings-icon"><c-icon name="book" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.copyrightInfo}}</text></view><text class="settings-value">{{vm.preferences.company}}</text><c-icon name="chevron" /></button>
      </view><text class="settings-footnote">{{vm.l.settingsSaved}}</text>
