      </view>
      <text class="settings-section-label">{{vm.l.general}}</text>
      <view class="settings-group">
        <button class="raw-button settings-row" data-a="language" bindtap="onAction"><view class="settings-icon"><c-icon name="globe" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.language}}</text></view><text class="settings-value">{{vm.language}}</text><c-icon name="chevron" /></button>
        <button class="raw-button settings-row" data-a="timezone" bindtap="onAction"><view class="settings-icon"><c-icon name="clock" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.timezone}}</text></view><text class="settings-value">{{vm.preferences.timezone}}</text><c-icon name="chevron" /></button>
