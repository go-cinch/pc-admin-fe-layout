      </block>
      <block wx:if="{{vm.view === 'security'}}">
        <view class="security-banner"><c-icon name="shield" tone="accent" /><view class="security-banner-copy"><text class="security-banner-title">{{vm.l.signedIn}}</text><text class="security-banner-note">{{vm.l.securityDescription}}</text></view></view>
        <view class="section-head"><text class="section-title">{{vm.l.loginDevices}}</text><c-tag>{{vm.l.mockData}}</c-tag></view><view class="card"><view wx:for="{{vm.deviceRows}}" wx:key="id" class="device-row"><view class="device-icon"><c-icon name="{{item.icon}}" /></view><view class="record-main"><text class="record-name">{{item.name}}</text><text class="record-note">{{item.platform}}</text><text class="record-note">{{item.location}} · {{item.lastSeenLabel}}</text></view><c-tag wx:if="{{item.current}}">{{vm.l.currentDevice}}</c-tag><button wx:else class="raw-button text-action" data-a="remove-device" data-v="{{item.id}}" bindtap="onAction">{{vm.l.remove}}</button></view></view>
        <view class="section-head"><text class="section-title">{{vm.l.accountProtection}}</text></view><view class="card"><button class="raw-button menu-row" data-a="password" bindtap="onAction"><c-icon name="key" tone="accent" /><text class="menu-label">{{vm.l.passwordChange}}</text><c-icon name="chevron" /></button><button class="raw-button menu-row" data-a="lock" bindtap="onAction"><c-icon name="lock" tone="accent" /><text class="menu-label">{{vm.l.lock}}</text><c-icon name="chevron" /></button></view>
      </block>
      <view wx:if="{{vm.footer || vm.view === 'auth'}}" class="copyright"><view class="copyright-line"><text wx:if="{{vm.footer}}" class="copyright-copy">{{vm.copyright}}</text><button wx:if="{{vm.view === 'auth'}}" class="raw-button icon-button footer-settings" data-a="settings" bindtap="onAction" aria-label="{{vm.l.interfaceSettings}}"><c-icon name="settings" /></button></view><text wx:if="{{vm.footer && vm.icp}}">{{vm.icp}}</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{vm.view !== 'auth'}}" class="dock"><button wx:for="{{vm.dock}}" wx:key="key" class="raw-button dock-item {{item.active ? 'active' : ''}}" data-testid="dock-{{item.key}}" data-a="navigate" data-v="{{item.path}}" bindtap="onAction"><view class="dock-icon"><c-icon name="{{item.icon}}" tone="{{item.active ? 'accent' : 'muted'}}" /><text wx:if="{{item.key === 'profile' && vm.unread > 0}}" class="notification-dot dock-dot" data-testid="mine-unread" aria-label="{{vm.l.unread}}"></text></view><text class="dock-label">{{item.label}}</text></button></view>
  <view wx:if="{{vm.settingsOpen}}" class="settings-screen">
    <view class="settings-topbar" style="padding-top:{{vm.native ? vm.topInset + 6 : 6}}px;padding-right:{{vm.native ? 104 : 16}}px"><button class="raw-button icon-button" data-a="close" bindtap="onAction" aria-label="{{vm.l.back}}"><c-icon name="back" /></button><text class="settings-title">{{vm.l.interfaceSettings}}</text></view>
    <scroll-view class="settings-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="settings-body">
      <text class="settings-description">{{vm.l.settingsDescription}}</text>
      <text class="settings-section-label">{{vm.l.appearance}}</text>
      <view class="settings-group">
        <view class="settings-row"><view class="settings-icon"><view class="settings-moon"></view></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.dark}}</text></view><c-switch class="ui-switch" name="preference.dark" checked="{{vm.preferences.dark}}" bind:change="onInput" /></view>
        <view class="settings-row"><view class="settings-icon"><c-icon name="layers" /></view><view class="settings-copy"><text class="settings-row-title">{{vm.l.reduced}}</text><text class="settings-row-note">{{vm.l.reducedHint}}</text></view><c-switch class="ui-switch" name="preference.reducedTransparency" checked="{{vm.preferences.reducedTransparency}}" bind:change="onInput" /></view>
