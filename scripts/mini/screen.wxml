  </view>
  <view wx:if="{{vm.sheet && vm.sheet.type !== 'settings'}}" class="overlay"><view class="mask" data-a="close" bindtap="onAction"></view><view class="sheet"><view class="handle"></view><view class="sheet-header"><text>{{vm.sheet.title}}</text><button class="raw-button icon-button" data-a="close" bindtap="onAction" aria-label="{{vm.l.close}}"><c-icon name="close" /></button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body">
    <view wx:if="{{vm.sheetError}}" class="error-banner" role="alert"><text class="error-copy">{{vm.sheetError}}</text><button wx:if="{{vm.sheet.type === 'detail' || vm.sheet.type === 'message'}}" class="raw-button text-action" data-a="detail-retry" bindtap="onAction">{{vm.l.retry}}</button></view><view wx:if="{{vm.sheet.loading}}" data-testid="skeleton-detail" aria-busy="true"><view wx:for="{{vm.skeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view>
    <block wx:if="{{(vm.sheet.type === 'detail' || vm.sheet.type === 'profile') && !vm.sheet.loading}}"><text class="detail-name">{{vm.recordName}}</text><view wx:for="{{vm.details}}" wx:key="key" class="detail-field"><text class="detail-label">{{item.label}}</text><scroll-view wx:if="{{item.json}}" class="json-box" scroll-y><text selectable>{{item.value}}</text></scroll-view><view wx:else class="detail-value"><view wx:if="{{item.tokens.length}}" class="token-list"><block wx:for="{{item.tokens}}" wx:for-item="token" wx:key="label"><button wx:if="{{token.path}}" class="raw-button token-link" data-a="navigate" data-v="{{token.path}}" bindtap="onAction"><c-tag tone="{{token.tone}}">{{token.label}}</c-tag><c-icon name="chevron" /></button><c-tag wx:else tone="{{token.tone}}">{{token.label}}</c-tag></block></view><block wx:else><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</text></block><text wx:if="{{item.note}}" class="record-note">{{item.note}}</text></view></view></block>
    <view wx:for="{{vm.fields}}" wx:key="key" data-testid="field-{{item.key}}" class="field {{item.error ? 'invalid' : ''}}"><text class="field-label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text></text><c-switch class="ui-switch" wx:if="{{item.kind === 'switch'}}" name="{{item.key}}" checked="{{item.value}}" bind:change="onInput" /><c-button class="ui-button" bind:press="onAction" wx:elif="{{item.kind === 'picker' || item.kind === 'filter-picker'}}" kind="outline" action="{{item.kind === 'filter-picker' ? 'filter-picker' : 'picker'}}" arg="{{item.key}}">{{item.display}}</c-button><c-datetime wx:elif="{{item.kind === 'datetime'}}" name="{{item.key}}" label="{{item.label}}" value="{{item.value}}" disabled="{{vm.busy}}" bind:change="onInput" /><c-textarea wx:elif="{{item.kind === 'textarea'}}" name="{{item.key}}" value="{{item.value}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" /><c-input wx:else name="{{item.key}}" value="{{item.value}}" password="{{item.kind === 'password'}}" placeholder="{{item.placeholder}}" disabled="{{vm.busy}}" bind:change="onInput" /><text wx:if="{{item.key === 'form.year'}}" class="hint">{{vm.l.autoYearHint}}</text><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text></view>
    <block wx:if="{{vm.sheet.type === 'password' && vm.captcha}}"><view class="section-head"><text>{{vm.captcha.hint_text}}</text><c-button class="ui-button" bind:press="onAction" action="refresh-captcha" kind="text">{{vm.l.refresh}}</c-button></view><view class="captcha" id="point-captcha" bindtap="onPoint"><image src="{{vm.captcha.captcha_image}}" mode="widthFix" /><text wx:for="{{vm.captcha.points}}" wx:key="label" class="captcha-point" style="left:{{item.left}}%;top:{{item.top}}%">{{item.label}}</text></view><text wx:if="{{vm.verificationError || vm.sliderError}}" class="field-error">{{vm.verificationError || vm.sliderError}}</text></block>
    <view wx:if="{{vm.sheet.type === 'picker' || vm.sheet.type === 'filter-picker'}}" class="search-field"><c-icon name="search" /><c-input name="picker" value="{{vm.optionsQuery}}" placeholder="{{vm.l.search}}" bind:change="onInput" bind:blur="onFieldBlur" /></view><view wx:if="{{vm.sheet.filter}}" class="filter-actions"><button class="raw-button text-action" data-a="filter-clear" bindtap="onAction">{{vm.l.reset}}</button><button class="raw-button text-action" data-a="filter-history-clear" bindtap="onAction">{{vm.l.clearHistory}}</button></view><view wx:if="{{vm.optionsLoading}}" data-testid="skeleton-options"><view wx:for="{{vm.skeletonRows}}" wx:key="id" class="skeleton-row" aria-hidden="true"><view class="skeleton skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line short"></view></view><view class="skeleton skeleton-tag"></view></view></view><view wx:for="{{vm.choices}}" wx:key="value" class="option-row"><button class="raw-button option {{item.selected ? 'active' : ''}}" data-a="{{item.action}}" data-v="{{item.value}}" bindtap="onAction"><view class="option-copy"><text wx:for="{{item.parts || []}}" wx:for-item="part" wx:key="index" class="{{part.match ? 'match' : ''}}">{{part.value}}</text><text wx:if="{{!item.parts || !item.parts.length}}">{{item.label}}</text></view><text>{{item.selected ? '✓' : ''}}</text></button><button wx:if="{{vm.sheet.filter && item.history}}" class="raw-button icon-button" data-a="filter-history-remove" data-v="{{item.value}}" bindtap="onAction" aria-label="{{vm.l.remove}}"><c-icon name="close" /></button></view><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' && vm.optionsMore}}" action="options-more" kind="text">{{vm.l.loadMore}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' && vm.sheetError}}" action="options-retry" kind="text">{{vm.l.retry}}</c-button>
    <block wx:if="{{vm.sheet.type === 'preferences'}}"><text class="settings-hint">{{vm.l.copyrightHiddenHint}}</text><view class="remember-row"><text>{{vm.l.copyrightVisible}}</text><c-switch class="ui-switch" name="form.copyright" checked="{{vm.form.copyright}}" bind:change="onInput" /></view></block>
    <block wx:if="{{vm.sheet.type === 'operation' && vm.sheet.operation === 'review'}}"><view class="chips"><button class="raw-button chip {{vm.form.decision === 'approve' ? 'active' : ''}}" data-a="decision" data-v="approve" bindtap="onAction">{{vm.extra.approve}}</button><button class="raw-button chip {{vm.form.decision === 'reject' ? 'active' : ''}}" data-a="decision" data-v="reject" bindtap="onAction">{{vm.extra.reject}}</button></view></block><block wx:if="{{vm.sheet.type === 'operation' && vm.sheet.operation === 'lock'}}"><view class="chips"><button class="raw-button chip {{vm.form.lockMode === 'until' ? 'active' : ''}}" data-a="lock-mode" data-v="until" bindtap="onAction">{{vm.extra.until}}</button><button class="raw-button chip {{vm.form.lockMode === 'permanent' ? 'active' : ''}}" data-a="lock-mode" data-v="permanent" bindtap="onAction">{{vm.extra.permanent}}</button></view></block>
    <block wx:if="{{vm.sheet.type === 'compose'}}"><text class="field-label">{{vm.extra.messageType}}</text><view class="chips"><button class="raw-button chip {{vm.form.type === 'notice' ? 'active' : ''}}" data-a="message-type" data-v="notice" bindtap="onAction">{{vm.extra.notice}}</button><button class="raw-button chip {{vm.form.type === 'system' ? 'active' : ''}}" data-a="message-type" data-v="system" bindtap="onAction">{{vm.extra.system}}</button></view><text class="field-label">{{vm.extra.scope}}</text><view class="chips"><button class="raw-button chip {{vm.form.scope === 'all' ? 'active' : ''}}" data-a="message-scope" data-v="all" bindtap="onAction">{{vm.l.all}}</button><button class="raw-button chip {{vm.form.scope === 'targeted' ? 'active' : ''}}" data-a="message-scope" data-v="targeted" bindtap="onAction">{{vm.extra.targeted}}</button></view></block>
