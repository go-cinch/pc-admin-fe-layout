    <text wx:if="{{vm.sheet.type === 'discard'}}" class="lead">{{vm.extra.discardHint}}</text>
  </view></scroll-view><view class="sheet-footer">
    <block wx:if="{{vm.sheet.type === 'detail' && !vm.sheet.loading && !vm.sheetError}}"><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canDelete}}" kind="danger" action="delete">{{vm.l.remove}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.canUpdate}}" kind="primary" action="edit">{{vm.l.edit}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate && vm.recordStatus === 0}}" action="review">{{vm.l.reviewAction}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate && vm.recordStatus !== 0}}" action="{{vm.recordStatus === 2 ? 'unlock-user' : 'lock-user'}}">{{vm.recordStatus === 2 ? vm.extra.unlock : vm.extra.lock}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.resource === 'user' && vm.canUpdate && vm.hasPasswordLock}}" action="unlock-password">{{vm.extra.unlockPassword}}</c-button></block>
    <c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'edit'}}" kind="primary" action="save" loading="{{vm.busy}}">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'lock-setup'}}" kind="primary" action="set-lock">{{vm.l.lock}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'password'}}" kind="primary" action="save-password" loading="{{vm.busy}}">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'compose'}}" kind="primary" action="send" loading="{{vm.busy}}">{{vm.l.send}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'timezone'}}" kind="primary" action="timezone-save">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'preferences'}}" kind="primary" action="save-preferences">{{vm.l.save}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'filters'}}" kind="primary" action="apply-filters">{{vm.l.confirm}}</c-button><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'picker' || vm.sheet.type === 'filter-picker' || vm.sheet.type === 'columns' || vm.sheet.type === 'language'}}" kind="primary" action="close">{{vm.l.done}}</c-button>
    <block wx:if="{{vm.sheet.type === 'operation'}}"><c-button class="ui-button" bind:press="onAction" action="close">{{vm.l.cancel}}</c-button><c-button class="ui-button" bind:press="onAction" kind="primary" action="operate" loading="{{vm.busy}}">{{vm.l.confirm}}</c-button></block><block wx:if="{{vm.sheet.type === 'discard'}}"><c-button class="ui-button" bind:press="onAction" action="keep-editing">{{vm.extra.keep}}</c-button><c-button class="ui-button" bind:press="onAction" kind="danger" action="discard">{{vm.extra.discard}}</c-button></block><block wx:if="{{vm.sheet.type === 'logout'}}"><c-button class="ui-button" bind:press="onAction" action="close">{{vm.l.cancel}}</c-button><c-button class="ui-button" bind:press="onAction" kind="danger" action="confirm-logout" loading="{{vm.busy}}">{{vm.l.logout}}</c-button></block><c-button class="ui-button" bind:press="onAction" wx:if="{{vm.sheet.type === 'message' && vm.canDeleteMessage && !vm.sheet.loading && !vm.sheetError}}" kind="danger" action="delete">{{vm.l.remove}}</c-button>
  </view></view></view>
  <view wx:if="{{vm.notice}}" class="bottom-notice" role="status" data-testid="notice">{{vm.notice}}</view>
  <view wx:if="{{vm.locked}}" class="lock-screen" data-testid="lock-screen"><view class="lock-content"><text class="lock-title">{{vm.l.locked}}</text><text class="lead">{{vm.l.lockHint}}</text><view wx:for="{{vm.lockFields}}" wx:key="key" class="field"><text class="field-label">{{item.label}}</text><c-input name="{{item.key}}" label="{{item.label}}" value="{{item.value}}" password="{{true}}" placeholder="{{item.placeholder}}" bind:change="onInput" /><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text></view><c-button class="ui-button" bind:press="onAction" action="unlock" kind="primary">{{vm.l.unlock}}</c-button><c-button class="ui-button" bind:press="onAction" action="lock-logout" kind="text">{{vm.l.logout}}</c-button></view></view>
