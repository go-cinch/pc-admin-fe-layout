<view class="datetime-field"><input class="datetime-input" name="{{name}}" data-field="{{name}}" value="{{value}}" disabled="{{disabled}}" placeholder="YYYY-MM-DD HH:mm:ss" bindinput="input" /><view class="datetime-control"><picker mode="date" value="{{date}}" disabled="{{disabled}}" bindchange="dateChange" data-testid="datetime-date"><view class="datetime-part">{{date || 'YYYY-MM-DD'}}</view></picker><picker mode="time" value="{{time}}" disabled="{{disabled}}" bindchange="timeChange" data-testid="datetime-time"><view class="datetime-part">{{time || 'HH:mm'}}</view></picker><button wx:if="{{value}}" class="datetime-clear" bindtap="clear" disabled="{{disabled}}" aria-label="×">×</button></view>
<view class="datetime-presets"><button class="datetime-preset" data-hours="1" bindtap="preset">+1h</button><button class="datetime-preset" data-hours="24" bindtap="preset">+1d</button><button class="datetime-preset" data-hours="168" bindtap="preset">+1w</button></view></view>