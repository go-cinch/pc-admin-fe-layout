<view class="native-input-row"><view class="native-input-control"><t-input  name="{{name}}" aria-label="{{label}}" value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}" maxlength="{{-1}}" borderless="{{true}}" type="{{password && !visible ? 'password' : 'text'}}" bind:change="change" bind:blur="blur" bind:focus="focus" /></view><button wx:if="{{password}}" class="password-toggle" bindtap="togglePassword" aria-label="{{locale === 'en-US' ? (visible ? 'Hide password' : 'Show password') : (visible ? '隐藏密码' : '显示密码')}}" data-testid="password-visibility"><c-icon name="eye" /></button></view>
