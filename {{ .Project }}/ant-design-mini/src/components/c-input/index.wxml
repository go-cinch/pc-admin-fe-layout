<view class="native-input-row"><view class="native-input-control"><ant-input style="padding:12px;min-height:46px;box-sizing:border-box" name="{{name}}" aria-label="{{label}}" value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}" controlled="{{true}}" maxLength="{{-1}}" password="{{password && !visible}}" type="text" bind:change="change" bind:blur="blur" bind:focus="focus" /></view><button wx:if="{{password}}" class="password-toggle" bindtap="togglePassword" aria-label="{{locale === 'en-US' ? (visible ? 'Hide password' : 'Show password') : (visible ? '隐藏密码' : '显示密码')}}" data-testid="password-visibility"><c-icon name="eye" /></button></view>
