# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 主接口地址
VITE_GLOB_API_URL=[[scaffold or .Scaffold.VITE_GLOB_API_URL "https://entry.go-cinch.top/api/auth" scaffold]]

# 认证接口地址
VITE_GLOB_AUTH_API_URL=[[scaffold or .Scaffold.VITE_GLOB_AUTH_API_URL "https://entry.go-cinch.top/api/auth" scaffold]]

# Delete console
VITE_DROP_CONSOLE = true
