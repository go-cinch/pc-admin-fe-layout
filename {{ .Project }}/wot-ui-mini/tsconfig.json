{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node",
      "miniprogram-api-typings",
      "@dcloudio/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.vue"
  ]
}
