#!/bin/sh
set -eu

# Escape apostrophes before placing template values in shell string literals.
project_dir='./{{ .Project | replace "\u0027" "\u0027\"\u0027\"\u0027" }}'
ui_dir="$project_dir/"'{{ .Computed.ui_final }}'

if [ ! -d "$ui_dir" ]; then
  printf 'Selected UI template is missing: %s\n' "$ui_dir" >&2
  exit 1
fi

logo_path='{{ or .Scaffold.logo_path "" | replace "\u0027" "\u0027\"\u0027\"\u0027" }}'
brand_slug='{{ (fromJSON .Computed.brand).slug }}'
logo_ext='{{ .Computed.logo_ext }}'
if [ -n "$logo_path" ]; then
  if [ '{{ .Computed.ui_final }}' != 'vben-antd-vue3' ]; then
    printf 'logo_path is supported only by the Vben template\n' >&2
    exit 1
  fi
  if [ ! -f "$logo_path" ] || [ ! -r "$logo_path" ] || [ ! -s "$logo_path" ]; then
    printf 'Logo must be a readable, non-empty file: %s\n' "$logo_path" >&2
    exit 1
  fi
fi

# Scaffold renders this source link as a regular file containing the current
# root AGENTS.md. No template checkout path is needed in the generated project.
shared_agents="$project_dir/.shared-agents.md"
if [ ! -s "$shared_agents" ]; then
  printf 'Shared frontend rules are missing: %s\n' "$shared_agents" >&2
  exit 1
fi
if [ -e "$project_dir/AGENTS.md" ] || [ -L "$project_dir/AGENTS.md" ]; then
  printf 'Cannot initialize project: destination already exists: %s/AGENTS.md\n' "$project_dir" >&2
  exit 1
fi

# Check every destination before moving anything, including hidden files.
for source in "$ui_dir"/* "$ui_dir"/.[!.]* "$ui_dir"/..?*; do
  [ -e "$source" ] || [ -L "$source" ] || continue
  target="$project_dir/${source##*/}"
  if [ -e "$target" ] || [ -L "$target" ]; then
    printf 'Cannot initialize project: destination already exists: %s\n' "$target" >&2
    exit 1
  fi
done

for source in "$ui_dir"/* "$ui_dir"/.[!.]* "$ui_dir"/..?*; do
  [ -e "$source" ] || [ -L "$source" ] || continue
  mv "$source" "$project_dir/"
done
rmdir "$ui_dir"

# Prefix shared rules, preserving the selected framework's instructions.
agents_output=$(mktemp "$project_dir/.agents.XXXXXX")
{
  printf '<!-- BEGIN SHARED FRONTEND RULES -->\n\n'
  cat "$shared_agents"
  printf '\n<!-- END SHARED FRONTEND RULES -->\n'
  if [ -f "$project_dir/AGENTS.md" ]; then
    printf '\n'
    cat "$project_dir/AGENTS.md"
  fi
} > "$agents_output"
chmod 644 "$agents_output"
mv "$agents_output" "$project_dir/AGENTS.md"
rm "$shared_agents"

if [ -n "$logo_path" ]; then
  public_dir="$project_dir/apps/web-antd/public"
  # Preserve the supplied bytes; a single image serves both themes and favicon.
  for suffix in '' '-white' '-favicon'; do
    cp "$logo_path" "$public_dir/$brand_slug$suffix$logo_ext"
    if [ "$logo_ext" != '.svg' ]; then
      rm "$public_dir/$brand_slug$suffix.svg"
    fi
  done
  # Browsers that request /favicon.ico directly must not get the bundled brand.
  if [ "$logo_ext" = '.ico' ]; then
    cp "$logo_path" "$public_dir/favicon.ico"
  else
    rm -f "$public_dir/favicon.ico"
  fi
fi
